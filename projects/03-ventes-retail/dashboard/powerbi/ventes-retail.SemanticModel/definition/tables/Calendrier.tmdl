table Calendrier
	lineageTag: d4e5f6a7-0003-0001-0001-000000000001
	dataCategory: Time

	column Date
		dataType: dateTime
		isKey
		formatString: dd/mm/yyyy
		lineageTag: d4e5f6a7-0003-0001-0001-000000000002
		summarizeBy: none
		isNameInferred
		sourceColumn: [Date]

		annotation SummarizationSetBy = Automatic

	column Année
		dataType: int64
		formatString: 0
		lineageTag: d4e5f6a7-0003-0001-0001-000000000003
		summarizeBy: none
		isNameInferred
		sourceColumn: [Année]

		annotation SummarizationSetBy = User

	column 'Mois num'
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: d4e5f6a7-0003-0001-0001-000000000004
		summarizeBy: none
		isNameInferred
		sourceColumn: [Mois num]

		annotation SummarizationSetBy = User

	column Mois
		dataType: string
		lineageTag: d4e5f6a7-0003-0001-0001-000000000005
		summarizeBy: none
		isNameInferred
		sourceColumn: [Mois]
		sortByColumn: 'Mois num'

		annotation SummarizationSetBy = Automatic

	column Année-Mois
		dataType: string
		lineageTag: d4e5f6a7-0003-0001-0001-000000000006
		summarizeBy: none
		isNameInferred
		sourceColumn: [Année-Mois]

		annotation SummarizationSetBy = Automatic

	column Trimestre
		dataType: string
		lineageTag: d4e5f6a7-0003-0001-0001-000000000007
		summarizeBy: none
		isNameInferred
		sourceColumn: [Trimestre]

		annotation SummarizationSetBy = Automatic

	partition Calendrier = calculated
		mode: import
		source =
				VAR _min = DATE(YEAR(MIN(superstore_clean[Order Date])), 1, 1)
				VAR _max = DATE(YEAR(MAX(superstore_clean[Order Date])), 12, 31)
				RETURN
				    ADDCOLUMNS(
				        CALENDAR(_min, _max),
				        "Année", YEAR([Date]),
				        "Mois num", MONTH([Date]),
				        "Mois", FORMAT([Date], "mmm"),
				        "Année-Mois", FORMAT([Date], "yyyy-mm"),
				        "Trimestre", "T" & QUARTER([Date])
				    )

	annotation PBI_ResultType = Table

