  "neutral": "#F5A524",
  "bad": "#D32F2F",
  "maximum": "#1C1A6E",
  "center": "#7B5CE6",
  "minimum": "#EEF2FC",
  "textClasses": {
    "callout": {
      "fontSize": 22,
      "fontFace": "Segoe UI Semibold",
      "color": "#0D0B4D"
    },
    "title": {
      "fontSize": 11,
      "fontFace": "Segoe UI Semibold",
      "color": "#16153A"
    },
    "header": {
      "fontSize": 10,
      "fontFace": "Segoe UI Semibold",
      "color": "#16153A"
    },
    "label": {
      "fontSize": 9,
      "fontFace": "Segoe UI",
      "color": "#16153A"
    }
  },
  "visualStyles": {
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#F4F4F8"
              }
            },
            "transparency": 0
          }
        ],
        "outspace": [
          {
            "color": {
              "solid": {
                "color": "#F4F4F8"
              }
            },
            "transparency": 0
          }
        ]
      }
    },
    "*": {
