table dim_education
	lineageTag: 04c4ed17-0004-0002-0000-000000000000

	column education_key
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 04c4ed17-0004-0002-0000-000000000001
		summarizeBy: none
		sourceColumn: education_key

	column Éducation
		dataType: string
		lineageTag: 04c4ed17-0004-0002-0000-000000000002
		summarizeBy: none
		sourceColumn: Éducation
		sortByColumn: education_key

	partition dim_education = m
		mode: import
		source =
				let
				    Source = Excel.Workbook(File.Contents(DossierDonnees & "Projet_04_04-risque-credit.xlsx"), null, true),
				    Feuille = Source{[Item="dim_education",Kind="Sheet"]}[Data],
				    Entetes = Table.PromoteHeaders(Feuille, [PromoteAllScalars=true]),
				    Colonnes = Table.SelectColumns(Entetes, {"education_key", "education_label"}),
				    Renomme = Table.RenameColumns(Colonnes, {{"education_label", "Éducation"}}),
				    Types = Table.TransformColumnTypes(Renomme, {{"education_key", Int64.Type}, {"Éducation", type text}})
				in
				    Types

	annotation PBI_ResultType = Table

