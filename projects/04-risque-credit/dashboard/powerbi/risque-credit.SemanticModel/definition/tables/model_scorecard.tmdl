	partition model_scorecard = m
		mode: import
		source =
				let
				    Source = Excel.Workbook(File.Contents(DossierDonnees & "Projet_04_04-risque-credit.xlsx"), null, true),
				    Feuille = Source{[Item="model_scorecard",Kind="Sheet"]}[Data],
				    Entetes = Table.PromoteHeaders(Feuille, [PromoteAllScalars=true]),
				    Colonnes = Table.SelectColumns(Entetes, {"train_clients", "test_clients", "test_default_rate", "decision_threshold", "roc_auc", "pr_auc_average_precision", "ks_statistic", "precision_at_threshold", "recall_at_threshold", "brier_score", "true_negative", "false_positive", "false_negative", "true_positive", "base_lgd_assumption", "risk_band_cutoffs", "protected_features_excluded"}),
				    Renomme = Table.RenameColumns(Colonnes, {{"risk_band_cutoffs", "Seuils des classes"}, {"protected_features_excluded", "Variables exclues"}}),
				    Types = Table.TransformColumnTypes(Renomme, {{"train_clients", Int64.Type}, {"test_clients", Int64.Type}, {"test_default_rate", type number}, {"decision_threshold", type number}, {"roc_auc", type number}, {"pr_auc_average_precision", type number}, {"ks_statistic", type number}, {"precision_at_threshold", type number}, {"recall_at_threshold", type number}, {"brier_score", type number}, {"true_negative", Int64.Type}, {"false_positive", Int64.Type}, {"false_negative", Int64.Type}, {"true_positive", Int64.Type}, {"base_lgd_assumption", type number}, {"Seuils des classes", type text}, {"Variables exclues", type text}})
				in
				    Types

	annotation PBI_ResultType = Table

