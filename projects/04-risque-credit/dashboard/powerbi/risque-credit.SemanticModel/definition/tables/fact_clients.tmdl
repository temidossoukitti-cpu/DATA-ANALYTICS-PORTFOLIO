		summarizeBy: none
		sourceColumn: Ordre utilisation

	partition fact_clients = m
		mode: import
		source =
				let
				    Source = Excel.Workbook(File.Contents(DossierDonnees & "Projet_04_04-risque-credit.xlsx"), null, true),
				    Feuille = Source{[Item="fact_clients",Kind="Sheet"]}[Data],
				    Entetes = Table.PromoteHeaders(Feuille, [PromoteAllScalars=true]),
				    Colonnes = Table.SelectColumns(Entetes, {"client_id", "limit_bal", "age", "bill_amt1", "pay_amt1", "default_next_month", "age_band_key", "limit_band_key", "education_key", "marriage_key", "pay_status_key", "utilization", "utilization_band", "max_delay_6m", "n_delays_6m", "risk_flag_recent_delay", "predicted_pd", "risk_band_key", "model_partition"}),
				    Types = Table.TransformColumnTypes(Colonnes, {{"client_id", Int64.Type}, {"limit_bal", type number}, {"age", Int64.Type}, {"bill_amt1", type number}, {"pay_amt1", type number}, {"default_next_month", Int64.Type}, {"age_band_key", Int64.Type}, {"limit_band_key", Int64.Type}, {"education_key", Int64.Type}, {"marriage_key", Int64.Type}, {"pay_status_key", Int64.Type}, {"utilization", type number}, {"utilization_band", type text}, {"max_delay_6m", Int64.Type}, {"n_delays_6m", Int64.Type}, {"risk_flag_recent_delay", Int64.Type}, {"predicted_pd", type number}, {"risk_band_key", Int64.Type}, {"model_partition", type text}}),
				    Echantillon = Table.AddColumn(Types, "Échantillon", each if [model_partition] = "Train" then "Apprentissage" else "Test", type text),
				    Defaut = Table.AddColumn(Echantillon, "Défaut observé", each if [default_next_month] = 1 then "Défaut" else "Sain", type text),
				    Retard = Table.AddColumn(Defaut, "Retard max (6 mois)", each if [max_delay_6m] = 0 then "Aucun retard" else Text.From([max_delay_6m]) & " mois", type text),
				    Util = Table.RenameColumns(Retard, {{"utilization_band", "Tranche d'utilisation"}}),
				    OrdreUtil = Table.AddColumn(Util, "Ordre utilisation", each if [#"Tranche d'utilisation"] = "<30 %" then 1 else if [#"Tranche d'utilisation"] = "30-<60 %" then 2 else if [#"Tranche d'utilisation"] = "60-100 %" then 3 else 4, Int64.Type),
				    Final = Table.RemoveColumns(OrdreUtil, {"model_partition"})
				in
				    Final

	annotation PBI_ResultType = Table

