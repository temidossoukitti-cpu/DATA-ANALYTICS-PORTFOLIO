				    #"Date" = Table.AddColumn(#"Type modifié", "Jour", each DateTime.Date([open_time]), type date),
				    #"Année" = Table.AddColumn(#"Date", "Année", each Text.From(Date.Year([Jour])), type text),
				    #"Mois" = Table.AddColumn(#"Année", "Mois", each Text.From(Date.Year([Jour])) & "-" & Text.PadStart(Text.From(Date.Month([Jour])), 2, "0"), type text),
				    #"Sens" = Table.AddColumn(#"Mois", "Bougie", each if [close] >= [open] then "Haussière" else "Baissière", type text)
				in
				    #"Sens"

