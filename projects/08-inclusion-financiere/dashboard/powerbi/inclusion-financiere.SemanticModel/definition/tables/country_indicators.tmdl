				    , RegFR = [#"High income" = "Économies à revenu élevé", #"Sub-Saharan Africa (excluding high income)" = "Afrique subsaharienne", #"Europe & Central Asia (excluding high income)" = "Europe & Asie centrale", #"Latin America & Caribbean (excluding high income)" = "Amérique latine & Caraïbes", #"Middle East & North Africa (excluding high income)" = "Moyen-Orient & Afrique du Nord", #"East Asia & Pacific (excluding high income)" = "Asie de l'Est & Pacifique", #"South Asia (excluding high income)" = "Asie du Sud"]
