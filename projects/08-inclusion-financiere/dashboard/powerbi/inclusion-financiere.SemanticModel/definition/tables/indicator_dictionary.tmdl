		sourceColumn: Définition

		annotation SummarizationSetBy = Automatic

	partition indicator_dictionary = m
		mode: import
		source =
				let
				    Source = Excel.Workbook(File.Contents(DossierDonnees & "Projet_08_08-inclusion-financiere.xlsx"), null, true),
				    indicator_dictionary_Sheet = Source{[Item="indicator_dictionary",Kind="Sheet"]}[Data],
				    Entetes = Table.PromoteHeaders(indicator_dictionary_Sheet, [PromoteAllScalars=true]),
				    Renomme = Table.RenameColumns(Entetes, {{"dashboard_label", "Indicateur"}, {"Indicator name", "Nom Banque mondiale"}, {"Definition", "Définition"}}),
				    Types = Table.TransformColumnTypes(Renomme, {{"Series_key", type text}, {"Indicateur", type text}, {"Nom Banque mondiale", type text}, {"Définition", type text}})
				in
				    Types

	annotation PBI_ResultType = Table

