	partition fact_model_test = m
		mode: import
		source =
				let
				    Source = Excel.Workbook(File.Contents(DossierDonnees & "Projet_05_05-fraude-bancaire.xlsx"), null, true),
				    fact_model_test_Sheet = Source{[Item="fact_model_test",Kind="Sheet"]}[Data],
				    #"En-têtes promus" = Table.PromoteHeaders(fact_model_test_Sheet, [PromoteAllScalars=true]),
				    #"Type modifié" = Table.TransformColumnTypes(#"En-têtes promus",{{"transaction_id", Int64.Type}, {"amount", type number}, {"outcome_key", Int64.Type}, {"sampling_weight", type number}, {"time_seconds", Int64.Type}, {"model_probability", type number}, {"model_prediction", Int64.Type}, {"baseline_amount_flag", Int64.Type}, {"eval_population_weight", type number}, {"loss_severity_assumption", Int64.Type}, {"legitimate_friction_cost_assumption", Int64.Type}, {"expected_cost_contribution", type number}, {"fraud_amount_missed_contribution", type number}, {"fraud_amount_intercepted_contribution", type number}, {"legitimate_amount_blocked_contribution", Int64.Type}, {"amount_band_key", Int64.Type}, {"time_window_key", Int64.Type}}),
				    #"Décision" = Table.AddColumn(#"Type modifié", "Décision modèle", each if [model_prediction] = 1 then "Alerte (bloquée)" else "Acceptée", type text),
				    #"Règle" = Table.AddColumn(#"Décision", "Décision règle montant", each if [baseline_amount_flag] = 1 then "Alerte (bloquée)" else "Acceptée", type text),
				    #"Tranche score" = Table.AddColumn(#"Règle", "Tranche de score", each
				        let s = Number.RoundDown(([model_probability] ?? 0) * 10) / 10, s2 = if s >= 1 then 0.9 else s
				        in Number.ToText(s2, "0.0", "en-US") & "–" & Number.ToText(s2 + 0.1, "0.0", "en-US"), type text)
				in
				    #"Tranche score"

	annotation PBI_ResultType = Table

