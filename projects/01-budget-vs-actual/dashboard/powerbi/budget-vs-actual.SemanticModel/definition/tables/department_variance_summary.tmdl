		lineageTag: f2f39d57-26c7-4262-aed3-5399187f77bb
		summarizeBy: sum
		sourceColumn: zero_budget_rows

		annotation SummarizationSetBy = Automatic

	column variance_pct
		dataType: double
		lineageTag: d2c7bdf2-2f51-4eb7-8d69-fa180bea4fda
		summarizeBy: none
		sourceColumn: variance_pct

		annotation SummarizationSetBy = User

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column unfavorable
		dataType: boolean
		formatString: """TRUE"";""TRUE"";""FALSE"""
		lineageTag: 152e35ff-8979-47fd-8f71-ac945b56f23c
		summarizeBy: none
		sourceColumn: unfavorable

		annotation SummarizationSetBy = Automatic

	column 'Tranche exécution'
		dataType: string
		lineageTag: 6d1f0a10-0002-4c3e-9a01-000000000001
		summarizeBy: none
		sourceColumn: Tranche exécution
		sortByColumn: 'Ordre tranche'

		annotation SummarizationSetBy = Automatic

	column 'Ordre tranche'
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 6d1f0a10-0002-4c3e-9a01-000000000002
		summarizeBy: none
		sourceColumn: Ordre tranche

		annotation SummarizationSetBy = User

	partition department_variance_summary = m
		mode: import
		source =
				let
				    Source = Excel.Workbook(File.Contents(DossierDonnees & "Projet_01_01-budget-vs-actual.xlsx"), null, true),
				    department_variance_summary_Sheet = Source{[Item="department_variance_summary",Kind="Sheet"]}[Data],
				    #"En-têtes promus" = Table.PromoteHeaders(department_variance_summary_Sheet, [PromoteAllScalars=true]),
				    #"Type modifié" = Table.TransformColumnTypes(#"En-têtes promus",{{"dept_rollup_name", type text}, {"department_name", type text}, {"budget", type number}, {"expenditures", type number}, {"variance", type number}, {"rows", Int64.Type}, {"zero_budget_rows", Int64.Type}, {"variance_pct", type number}, {"unfavorable", type logical}}),
				    #"Ordre ajouté" = Table.AddColumn(#"Type modifié", "Ordre tranche", each
				        if [budget] = null or [budget] = 0 then 6
				        else let r = [expenditures] / [budget] in
				            if r > 1 then 5
				            else if r >= 0.9 then 4
				            else if r >= 0.75 then 3
				            else if r >= 0.5 then 2
				            else 1, Int64.Type),
				    #"Tranche ajoutée" = Table.AddColumn(#"Ordre ajouté", "Tranche exécution", each
				        {"< 50 %", "50 – 75 %", "75 – 90 %", "90 – 100 %", "> 100 %", "Sans budget"}{[Ordre tranche] - 1}, type text)
				in
				    #"Tranche ajoutée"

	annotation PBI_ResultType = Table

