table department_variance_summary
	lineageTag: 9020a172-4807-478b-b26d-ff86a5fe81b4

	measure 'Budget total' = SUM(department_variance_summary[budget])
		formatString: \$#,0
		displayFolder: 1. Montants
		lineageTag: 6d1f0a10-0001-4c3e-9a01-000000000001

	measure 'Dépenses totales' = SUM(department_variance_summary[expenditures])
		formatString: \$#,0
		displayFolder: 1. Montants
		lineageTag: 6d1f0a10-0001-4c3e-9a01-000000000002

	measure 'Écart total' = [Dépenses totales] - [Budget total]
		formatString: \$#,0;-\$#,0;\$#,0
		displayFolder: 1. Montants
		lineageTag: 6d1f0a10-0001-4c3e-9a01-000000000003

	measure 'Budget non consommé' = MAX(0, [Budget total] - [Dépenses totales])
		formatString: \$#,0
		displayFolder: 1. Montants
		lineageTag: 6d1f0a10-0001-4c3e-9a01-000000000004

	measure 'Exécution %' = DIVIDE([Dépenses totales], [Budget total])
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 2. Ratios
		lineageTag: 6d1f0a10-0001-4c3e-9a01-000000000005

	measure 'Écart %' = DIVIDE([Écart total], [Budget total])
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 2. Ratios
		lineageTag: 6d1f0a10-0001-4c3e-9a01-000000000006

	measure 'Lignes sans budget %' = DIVIDE(SUM(department_variance_summary[zero_budget_rows]), SUM(department_variance_summary[rows]))
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 2. Ratios
		lineageTag: 6d1f0a10-0001-4c3e-9a01-000000000007

	measure 'Nb départements' = DISTINCTCOUNT(department_variance_summary[department_name])
		formatString: 0
		displayFolder: 3. Comptages
		lineageTag: 6d1f0a10-0001-4c3e-9a01-000000000008

	measure 'Départements sous 75 %' =
			COUNTROWS(
			    FILTER(
			        VALUES(department_variance_summary[department_name]),
			        [Budget total] > 0 && [Exécution %] < 0.75
			    )
			) + 0
		formatString: 0
		displayFolder: 3. Comptages
		lineageTag: 6d1f0a10-0001-4c3e-9a01-000000000009

	measure 'Lignes budgétaires' = SUM(department_variance_summary[rows])
		formatString: #,0
		displayFolder: 3. Comptages
		lineageTag: 6d1f0a10-0001-4c3e-9a01-000000000010

	measure 'Top 10 budget non consommé' =
			VAR _rang =
			    RANKX(
			        ALLSELECTED(department_variance_summary[department_name]),
			        [Budget non consommé], , DESC, Dense
			    )
			RETURN
			    IF(_rang <= 10 && [Budget non consommé] > 0, [Budget non consommé])
		formatString: \$#,0
		displayFolder: 4. Classements
		lineageTag: 6d1f0a10-0001-4c3e-9a01-000000000011

	measure 'Couleur exécution' =
			VAR _e = [Exécution %]
			RETURN
			    SWITCH(
			        TRUE(),
			        ISBLANK(_e), "#9AA3B5",
			        _e > 1, "#D64545",
			        _e >= 0.9, "#1F9D74",
			        _e >= 0.75, "#3E6FD8",
			        _e >= 0.5, "#F2A93B",
			        "#D64545"
			    )
		displayFolder: 5. Mise en forme
		lineageTag: 6d1f0a10-0001-4c3e-9a01-000000000012

	measure 'Titre filtre' =
			IF(
			    ISFILTERED(department_variance_summary[dept_rollup_name]),
			    "Regroupement : " & CONCATENATEX(VALUES(department_variance_summary[dept_rollup_name]), department_variance_summary[dept_rollup_name], ", "),
			    "Tous les regroupements"
			)
		displayFolder: 5. Mise en forme
		lineageTag: 6d1f0a10-0001-4c3e-9a01-000000000013

	column dept_rollup_name
