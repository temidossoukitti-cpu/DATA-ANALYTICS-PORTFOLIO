	partition fact_campaign = m
		mode: import
		source =
				let
				    Source = Excel.Workbook(File.Contents(DossierDonnees & "Projet_07_07-marketing-bancaire.xlsx"), null, true),
				    fact_campaign_Sheet = Source{[Item="fact_campaign",Kind="Sheet"]}[Data],
				    #"En-têtes promus" = Table.PromoteHeaders(fact_campaign_Sheet, [PromoteAllScalars=true]),
				    #"Type modifié" = Table.TransformColumnTypes(#"En-têtes promus",{{"campaign_id", Int64.Type}, {"age", Int64.Type}, {"age_band_key", Int64.Type}, {"job_key", Int64.Type}, {"marital_key", Int64.Type}, {"education_key", Int64.Type}, {"default_status", type text}, {"housing_loan", type text}, {"personal_loan", type text}, {"contact_key", Int64.Type}, {"month_key", Int64.Type}, {"day_of_week", type text}, {"duration", Int64.Type}, {"campaign", Int64.Type}, {"campaign_band_key", Int64.Type}, {"pdays", Int64.Type}, {"previously_contacted", Int64.Type}, {"previous", Int64.Type}, {"poutcome_key", Int64.Type}, {"emp.var.rate", type number}, {"cons.price.idx", type number}, {"cons.conf.idx", type number}, {"euribor3m", type number}, {"nr.employed", Int64.Type}, {"outcome_key", Int64.Type}})
				in
				    #"Type modifié"

