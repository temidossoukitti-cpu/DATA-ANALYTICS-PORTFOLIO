        "labels": [
          {
            "color": {
              "solid": {
                "color": "#16324F"
              }
            },
            "fontSize": 28,
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "categoryLabels": [
          {
            "show": false
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "header": [
          {
            "show": false
          }
        ],
        "items": [
          {
            "fontColor": {
              "solid": {
                "color": "#243B53"
              }
            },
            "textSize": 10,
            "fontFamily": "Segoe UI"
          }
        ]
