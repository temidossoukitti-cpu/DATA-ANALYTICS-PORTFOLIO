{
  "name": "Executive Analytics Template",
  "dataColors": [
    "#176B78",
    "#4F6B78",
    "#3F7D6A",
    "#A6783D",
    "#6B6585",
    "#4D7699",
    "#8A6D63",
    "#71815B"
  ],
  "background": "#F3F5F7",
  "foreground": "#172B3A",
  "tableAccent": "#176B78",
  "good": "#2F7D62",
  "neutral": "#A6783D",
  "bad": "#B45454",
  "maximum": "#176B78",
  "center": "#D9E1E6",
  "minimum": "#B45454",
  "null": "#A4AFB7",
  "textClasses": {
    "callout": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 28,
      "color": "#172B3A"
    },
    "title": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 12,
      "color": "#172B3A"
    },
    "header": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 11,
      "color": "#172B3A"
    },
    "label": {
      "fontFace": "Segoe UI",
      "fontSize": 10,
      "color": "#536572"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 100
          }
        ],
        "border": [
          {
            "show": false,
            "radius": 4
          }
        ],
        "visualHeader": [
          {
            "show": false
          }
        ],
        "title": [
          {
            "show": false,
            "fontColor": {
              "solid": {
                "color": "#172B3A"
              }
            },
            "background": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "textSize": 12,
            "fontFamily": "Segoe UI Semibold",
            "alignment": "left"
          }
        ]
      }
    },
    "card": {
      "*": {
        "labels": [
          {
            "color": {
              "solid": {
                "color": "#172B3A"
              }
            },
            "fontSize": 28,
            "fontFamily": "Segoe UI Semibold",
            "displayUnits": 0,
            "labelPrecision": 1
          }
        ],
        "categoryLabels": [
          {
            "show": false,
            "color": {
              "solid": {
                "color": "#536572"
              }
            },
            "fontSize": 10,
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "wordWrap": [
          {
            "show": false
          }
        ]
      }
    },
    "cardVisual": {
      "*": {
        "calloutValues": [
          {
            "fontFace": "Segoe UI Semibold",
            "fontSize": 28,
            "color": {
              "solid": {
                "color": "#172B3A"
              }
            }
          }
        ],
        "categoryLabels": [
          {
            "show": false,
            "fontFace": "Segoe UI Semibold",
            "fontSize": 10,
            "color": {
              "solid": {
                "color": "#536572"
              }
            }
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "header": [
          {
            "show": false,
            "fontColor": {
              "solid": {
                "color": "#536572"
              }
            },
            "textSize": 10,
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "items": [
          {
            "fontColor": {
              "solid": {
                "color": "#172B3A"
              }
            },
            "background": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "textSize": 10,
            "fontFamily": "Segoe UI"
          }
        ],
        "selection": [
          {
            "selectAllCheckboxEnabled": true,
            "singleSelect": false
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "grid": [
          {
            "gridVertical": false,
            "gridHorizontal": true,
            "outlineColor": {
              "solid": {
                "color": "#DDE3E7"
              }
            },
            "rowPadding": 6,
            "textSize": 10
          }
        ],
        "columnHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "backColor": {
              "solid": {
                "color": "#243D4D"
              }
            },
            "fontFamily": "Segoe UI Semibold",
            "fontSize": 10,
            "alignment": "left",
            "wordWrap": true
          }
        ],
        "values": [
          {
            "fontColorPrimary": {
              "solid": {
                "color": "#273B49"
              }
            },
            "backColorPrimary": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "fontColorSecondary": {
              "solid": {
                "color": "#273B49"
              }
            },
            "backColorSecondary": {
              "solid": {
                "color": "#F7F8F9"
              }
            },
            "fontFamily": "Segoe UI",
            "fontSize": 10,
            "wordWrap": false
          }
        ],
        "total": [
          {
            "fontColor": {
              "solid": {
                "color": "#172B3A"
              }
            },
            "backColor": {
              "solid": {
                "color": "#E9EEF1"
              }
            },
            "fontFamily": "Segoe UI Semibold",
            "fontSize": 10
          }
        ]
      }
    },
    "matrix": {
      "*": {
        "grid": [
          {
            "gridVertical": false,
            "gridHorizontal": true,
            "outlineColor": {
              "solid": {
                "color": "#DDE3E7"
              }
            },
            "rowPadding": 6
          }
        ],
        "columnHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "backColor": {
              "solid": {
                "color": "#243D4D"
              }
            },
            "fontFamily": "Segoe UI Semibold",
            "fontSize": 10
          }
        ],
        "rowHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#273B49"
              }
            },
            "backColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "fontFamily": "Segoe UI",
            "fontSize": 10
          }
        ],
        "values": [
          {
            "fontColorPrimary": {
              "solid": {
                "color": "#273B49"
              }
            },
            "backColorPrimary": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "fontColorSecondary": {
              "solid": {
                "color": "#273B49"
              }
            },
            "backColorSecondary": {
              "solid": {
                "color": "#F7F8F9"
              }
            },
            "fontFamily": "Segoe UI",
            "fontSize": 10
          }
        ]
      }
    },
    "lineChart": {
      "*": {
        "legend": [
          {
            "show": true,
            "position": "Top",
            "showTitle": false,
            "labelColor": {
              "solid": {
                "color": "#536572"
              }
            },
            "fontFamily": "Segoe UI",
            "fontSize": 9
          }
        ],
        "categoryAxis": [
          {
            "show": true,
            "labelColor": {
              "solid": {
                "color": "#6B7B86"
              }
            },
            "fontSize": 9,
            "fontFamily": "Segoe UI",
            "showAxisTitle": false,
            "showGridlines": false
          }
        ],
        "valueAxis": [
          {
            "show": true,
            "labelColor": {
              "solid": {
                "color": "#6B7B86"
              }
            },
            "fontSize": 9,
            "fontFamily": "Segoe UI",
            "showAxisTitle": false,
            "gridlineColor": {
              "solid": {
                "color": "#E7EBEE"
              }
            },
            "gridlineStyle": "dotted"
          }
        ],
        "lineStyles": [
          {
            "strokeWidth": 3,
            "showMarker": false
          }
        ]
      }
    },
    "barChart": {
      "*": {
        "legend": [
          {
            "show": false
          }
        ],
        "categoryAxis": [
          {
            "labelColor": {
              "solid": {
                "color": "#536572"
              }
            },
            "fontSize": 9,
            "fontFamily": "Segoe UI",
            "showAxisTitle": false,
            "showGridlines": false
          }
        ],
        "valueAxis": [
          {
            "labelColor": {
              "solid": {
                "color": "#6B7B86"
              }
            },
            "fontSize": 9,
            "fontFamily": "Segoe UI",
            "showAxisTitle": false,
            "gridlineColor": {
              "solid": {
                "color": "#E7EBEE"
              }
            }
          }
        ],
        "labels": [
          {
            "show": false,
            "color": {
              "solid": {
                "color": "#273B49"
              }
            },
            "fontSize": 9,
            "fontFamily": "Segoe UI"
          }
        ]
      }
    },
    "columnChart": {
      "*": {
        "legend": [
          {
            "show": false
          }
        ],
        "categoryAxis": [
          {
            "labelColor": {
              "solid": {
                "color": "#536572"
              }
            },
            "fontSize": 9,
            "fontFamily": "Segoe UI",
            "showAxisTitle": false,
            "showGridlines": false
          }
        ],
        "valueAxis": [
          {
            "labelColor": {
              "solid": {
                "color": "#6B7B86"
              }
            },
            "fontSize": 9,
            "fontFamily": "Segoe UI",
            "showAxisTitle": false,
            "gridlineColor": {
              "solid": {
                "color": "#E7EBEE"
              }
            }
          }
        ]
      }
    },
    "pieChart": {
      "*": {
        "legend": [
          {
            "show": true,
            "position": "RightCenter",
            "showTitle": false,
            "labelColor": {
              "solid": {
                "color": "#536572"
              }
            },
            "fontSize": 9,
            "fontFamily": "Segoe UI"
          }
        ],
        "labels": [
          {
            "show": true,
            "labelStyle": "Percent of total",
            "color": {
              "solid": {
                "color": "#273B49"
              }
            },
            "fontSize": 9,
            "fontFamily": "Segoe UI"
          }
        ]
      }
    }
  }
}
